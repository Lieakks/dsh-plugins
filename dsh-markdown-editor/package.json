{
  "name": "@lieakks/dsh-markdown-editor",
  "version": "1.1.1",
  "license": "MIT",
  "description": "Inline Markdown editor for the right Sidebar's document preview, with a Typora-style instant-render mode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lieakks/dsh-plugins.git",
    "directory": "dsh-markdown-editor"
  },
  "homepage": "https://github.com/Lieakks/dsh-plugins/tree/main/dsh-markdown-editor",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "editor",
    "vditor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/README.zh.md",
    "THIRD-PARTY-NOTICES.md",
    "src",
    "vendor"
  ],
  "scripts": {
    "build": "node build/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
