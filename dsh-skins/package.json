{
  "name": "@lieakks/dsh-skins",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Skin palettes and a custom background image for the Harness Web UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lieakks/dsh-plugins.git",
    "directory": "dsh-skins"
  },
  "homepage": "https://github.com/Lieakks/dsh-plugins/tree/main/dsh-skins",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "wallpaper"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
